{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cucumber: current feature file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber-js",
      "args": ["${file}"],
      "env": { "HEADLESS": "false", "SLOW_MO": "150", "TRACE": "on", "STEP_OVERLAY": "true" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Cucumber: @smoke",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber-js",
      "args": ["--profile", "smoke"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
