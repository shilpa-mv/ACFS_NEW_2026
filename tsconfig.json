{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts", "pages/**/*.ts", "config/**/*.ts", "playwright-utils/**/*.ts", "api-clients/**/*.ts", "services/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "allure-results", "test-results"]
}
